{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="os24-sets color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="os24-section-head">
      <div>
        {%- if section.settings.heading != blank -%}
          <h2 class="os24-section-head__title h1">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <p class="os24-sets__intro">{{ section.settings.text | escape }}</p>
        {%- endif -%}
      </div>
    </div>

    <ul class="os24-sets__grid list-unstyled" role="list">
      {%- for block in section.blocks -%}
        {%- assign curtain = block.settings.curtain -%}
        {%- assign bedsheet = block.settings.bedsheet -%}
        <li class="os24-sets__card" {{ block.shopify_attributes }}>
          <div class="os24-sets__media">
            {%- for item in (1..2) -%}
              {%- if item == 1 -%}
                {%- assign set_product = curtain -%}
                {%- assign placeholder_name = 'product-1' -%}
              {%- else -%}
                {%- assign set_product = bedsheet -%}
                {%- assign placeholder_name = 'product-2' -%}
              {%- endif -%}
              <a
                class="os24-sets__image os24-media"
                {% if set_product != blank %}
                  href="{{ set_product.url }}"
                {% else %}
                  role="link" aria-disabled="true"
                {% endif %}
                tabindex="-1"
                aria-hidden="true"
              >
                {%- if set_product.featured_media != blank -%}
                  {{
                    set_product.featured_media
                    | image_url: width: 700
                    | image_tag:
                      loading: 'lazy',
                      widths: '300, 450, 600, 700',
                      sizes: '(min-width: 990px) 25vw, 50vw',
                      class: 'os24-media__img',
                      alt: ''
                  }}
                {%- else -%}
                  {{ placeholder_name | placeholder_svg_tag: 'placeholder-svg os24-media__img' }}
                {%- endif -%}
              </a>
            {%- endfor -%}
          </div>

          <div class="os24-sets__body">
            <h3 class="os24-sets__title h3">{{ block.settings.title | escape }}</h3>
            <ul class="os24-sets__links list-unstyled" role="list">
              {%- if curtain != blank -%}
                <li>
                  <a href="{{ curtain.url }}" class="os24-sets__link">
                    <span>Curtain</span>
                    <span class="os24-sets__price">
                      {%- if curtain.price_varies %}From {% endif -%}
                      {{- curtain.price_min | money -}}
                    </span>
                  </a>
                </li>
              {%- endif -%}
              {%- if bedsheet != blank -%}
                <li>
                  <a href="{{ bedsheet.url }}" class="os24-sets__link">
                    <span>Bedsheet</span>
                    <span class="os24-sets__price">
                      {%- if bedsheet.price_varies %}From {% endif -%}
                      {{- bedsheet.price_min | money -}}
                    </span>
                  </a>
                </li>
              {%- endif -%}
            </ul>
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "24 · Matching sets",
  "tag": "section",
  "class": "section os24-section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Matching curtain & bedsheet sets"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Intro text",
      "default": "Same print, made to go together. Pick the curtain and the bedsheet in one design."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "set",
      "name": "Matching set",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Design name",
          "default": "Design name"
        },
        {
          "type": "product",
          "id": "curtain",
          "label": "Curtain"
        },
        {
          "type": "product",
          "id": "bedsheet",
          "label": "Bedsheet"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "24 · Matching sets",
      "blocks": [
        { "type": "set" },
        { "type": "set" }
      ]
    }
  ]
}
{% endschema %}
