{%- comment -%}
  24 OnlineShop contact page: chat/call/email buttons and quick answers on the left,
  the contact form on the right. Name, email, phone, topic and message are required;
  window measurements show only for "Custom size quote". On phones the buttons come
  first. Contact details live in Theme settings › 24 · Contact details.
  A "?topic=sizing" link (e.g. from the product size guide) preselects "Custom size quote".
{%- endcomment -%}
{{ 'section-contact-form.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="os24-contact color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="os24-contact__intro">
      <h1 class="os24-contact__title h1">{{ page.title | default: section.settings.heading | escape }}</h1>
      {%- if section.settings.intro != blank -%}
        <div class="os24-contact__lead rte">{{ section.settings.intro }}</div>
      {%- endif -%}
    </div>

    <div class="os24-contact__grid">
      <div class="os24-contact__aside">
        <h2 class="os24-contact__subhead h3">Talk to us</h2>
        {% render 'os24-contact-links', style: 'buttons' %}

        <ul class="os24-contact__facts list-unstyled" role="list">
          {%- for block in section.blocks -%}
            <li {{ block.shopify_attributes }}>
              <strong>{{ block.settings.title | escape }}</strong>
              {%- if block.settings.text != blank %} {{ block.settings.text | escape }}{% endif -%}
            </li>
          {%- endfor -%}
        </ul>
      </div>

      <div class="os24-contact__form contact">
        <h2 class="os24-contact__subhead h3">Send a message</h2>
        {%- form 'contact', id: 'ContactForm', class: 'isolate' -%}
          {%- if form.posted_successfully? -%}
            <h2 class="form-status form-status-list form__message" tabindex="-1" autofocus>
              {{- 'icon-success.svg' | inline_asset_content -}}
              {{ 'templates.contact.form.post_success' | t }}
            </h2>
          {%- elsif form.errors -%}
            <div class="form__message">
              <h2 class="form-status caption-large text-body" role="alert" tabindex="-1" autofocus>
                {{- 'icon-error.svg' | inline_asset_content -}}
                {{ 'templates.contact.form.error_heading' | t }}
              </h2>
            </div>
            <ul class="form-status-list caption-large" role="list">
              <li>
                <a href="#ContactForm-email" class="link">
                  {{ form.errors.translated_fields.email | capitalize }}
                  {{ form.errors.messages.email }}
                </a>
              </li>
            </ul>
          {%- endif -%}

          <div class="contact__fields">
            <div class="field">
              <input
                class="field__input"
                autocomplete="name"
                type="text"
                id="ContactForm-name"
                name="contact[{{ 'templates.contact.form.name' | t }}]"
                value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
                required
                aria-required="true"
                placeholder="{{ 'templates.contact.form.name' | t }}"
              >
              <label class="field__label" for="ContactForm-name">
                {{- 'templates.contact.form.name' | t }}
                <span aria-hidden="true">*</span></label
              >
            </div>
            <div class="field field--with-error">
              <input
                autocomplete="email"
                type="email"
                id="ContactForm-email"
                class="field__input"
                name="contact[email]"
                spellcheck="false"
                autocapitalize="off"
                value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                aria-required="true"
                required
                {% if form.errors contains 'email' %}
                  aria-invalid="true"
                  aria-describedby="ContactForm-email-error"
                {% endif %}
                placeholder="Email, so we can reply"
              >
              <label class="field__label" for="ContactForm-email">
                Email, so we can reply
                <span aria-hidden="true">*</span></label
              >
              {%- if form.errors contains 'email' -%}
                <small class="contact__field-error" id="ContactForm-email-error">
                  <span class="visually-hidden">{{ 'accessibility.error' | t }}</span>
                  <span class="form__message">
                    <span class="svg-wrapper">
                      {{- 'icon-error.svg' | inline_asset_content -}}
                    </span>
                    {{- form.errors.translated_fields.email | capitalize }}
                    {{ form.errors.messages.email -}}
                  </span>
                </small>
              {%- endif -%}
            </div>
          </div>

          <div class="field">
            <input
              type="tel"
              id="ContactForm-phone"
              class="field__input"
              autocomplete="tel"
              name="contact[{{ 'templates.contact.form.phone' | t }}]"
              pattern="[\d\s+\-\(\)]{7,}"
              title="Mobile number, e.g. 0917 123 4567 or +63 917 123 4567"
              value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
              required
              aria-required="true"
              placeholder="{{ 'templates.contact.form.phone' | t }}"
            >
            <label class="field__label" for="ContactForm-phone">
              {{- 'templates.contact.form.phone' | t }}
              <span aria-hidden="true">*</span></label
            >
          </div>

          <div class="os24-contact__select">
            <label class="visually-hidden" for="ContactForm-topic">Topic</label>
            <div class="select">
              <select
                id="ContactForm-topic"
                class="select__select"
                name="contact[Topic]"
                required
                aria-required="true"
              >
                <option value="" selected>Topic *</option>
                <option value="Custom size quote">Custom size quote</option>
                <option value="Order status">Order status</option>
                <option value="Product question">Product question</option>
                <option value="Other">Other</option>
              </select>
              <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
            </div>
          </div>

          {%- comment -%} Shown only when the topic is "Custom size quote" (script below). {%- endcomment -%}
          <fieldset class="os24-contact__measure" id="ContactForm-measure" hidden>
            <legend class="os24-contact__label">Window size (optional, in inches)</legend>
            <div class="contact__fields">
              <div class="field">
                <input
                  type="text"
                  inputmode="decimal"
                  id="ContactForm-width"
                  class="field__input"
                  name="contact[Window width (in)]"
                  placeholder="Width"
                >
                <label class="field__label" for="ContactForm-width">Width</label>
              </div>
              <div class="field">
                <input
                  type="text"
                  inputmode="decimal"
                  id="ContactForm-height"
                  class="field__input"
                  name="contact[Window height (in)]"
                  placeholder="Height"
                >
                <label class="field__label" for="ContactForm-height">Height</label>
              </div>
            </div>
            <p class="os24-contact__hint">
              Width: the length of your curtain rod. Height: from the rod down to the window sill or floor.
            </p>
          </fieldset>

          <div class="field">
            <textarea
              rows="6"
              id="ContactForm-body"
              class="text-area field__input"
              name="contact[body]"
              required
              aria-required="true"
              placeholder="Message"
            >
              {{- form.body -}}
            </textarea>
            <label class="form__label field__label" for="ContactForm-body">
              Message
              <span aria-hidden="true">*</span></label
            >
          </div>

          <div class="contact__button">
            <button type="submit" class="button">Send message</button>
          </div>
        {%- endform -%}
      </div>
    </div>
  </div>
</div>

<script>
  (function () {
    var select = document.getElementById('ContactForm-topic');
    var measure = document.getElementById('ContactForm-measure');
    if (!select) return;

    // "?topic=sizing" (from the product size guide) preselects Custom size quote.
    var map = { sizing: 'Custom size quote', order: 'Order status', product: 'Product question' };
    var topic = new URLSearchParams(window.location.search).get('topic');
    if (topic && map[topic]) select.value = map[topic];

    function toggleMeasure() {
      if (measure) measure.hidden = select.value !== 'Custom size quote';
    }

    select.addEventListener('change', toggleMeasure);
    toggleMeasure();
  })();
</script>

{% schema %}
{
  "name": "24 · Contact page",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 6,
  "settings": [
    {
      "type": "paragraph",
      "content": "Messenger, phone, email and hours come from Theme settings › 24 · Contact details."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading (if the page has no title)",
      "default": "Contact us"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro",
      "default": "<p>Questions about a product, your order or a custom size? Message us and we'll get back to you during business hours.</p>"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "fact",
      "name": "Quick answer",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Delivery:"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "3–7 days nationwide"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "24 · Contact page"
    }
  ]
}
{% endschema %}
