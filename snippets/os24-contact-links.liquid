{%- comment -%}
  Messenger / Viber / Call / Email links from Theme settings › 24 · Contact details.
  Used by sections/os24-contact.liquid (style: 'buttons') and the footer's
  "24 · Contact details" block (style: 'list'). Empty settings are skipped.

  Accepts:
  - style: {String} 'buttons' or 'list'
  - hide_email: {Boolean} true to leave out the email link (the Contact page does this,
    since its form already reaches the store's email)
{%- endcomment -%}
{%- liquid
  assign phone = settings.os24_phone | strip
  assign phone_link = phone | remove: ' ' | remove: '-'
  assign email = settings.os24_email | strip
  if hide_email
    assign email = ''
  endif
-%}
<ul class="os24-contact-links os24-contact-links--{{ style }} list-unstyled" role="list">
  {%- if settings.os24_messenger_url != blank -%}
    <li>
      <a href="{{ settings.os24_messenger_url }}" class="os24-contact-links__item" target="_blank" rel="noopener">
        <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="22" height="22">
          <path d="M12 3C6.9 3 3 6.7 3 11.4c0 2.6 1.2 4.9 3.2 6.4V21l2.9-1.6c.9.3 1.9.4 2.9.4 5.1 0 9-3.7 9-8.4S17.1 3 12 3z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
          <path d="M7.5 13.5l3-3.2 2.2 2 3.8-2.8-3 3.2-2.2-2z" fill="currentColor"/>
        </svg>
        <span>
          <span class="os24-contact-links__label">Messenger</span>
          {%- if style == 'buttons' -%}<span class="os24-contact-links__detail">Chat with us on Facebook</span>{%- endif -%}
        </span>
      </a>
    </li>
  {%- endif -%}
  {%- if phone != blank -%}
    <li>
      <a href="viber://chat?number={{ phone_link | url_encode }}" class="os24-contact-links__item">
        <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="22" height="22">
          <rect x="6" y="2.5" width="12" height="19" rx="2.5" fill="none" stroke="currentColor" stroke-width="1.8"/>
          <path d="M10 18h4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
        </svg>
        <span>
          <span class="os24-contact-links__label">Viber</span>
          <span class="os24-contact-links__detail">{{ phone | escape }}</span>
        </span>
      </a>
    </li>
    <li>
      <a href="tel:{{ phone_link | escape }}" class="os24-contact-links__item">
        <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="22" height="22">
          <path d="M6.6 3.5l2.6.4 1.2 3.6-1.8 1.4a12 12 0 0 0 6.5 6.5l1.4-1.8 3.6 1.2.4 2.6c-.2 1.3-1.3 2.2-2.6 2.1C10.5 19 5 13.5 4.5 6.1 4.4 4.8 5.3 3.7 6.6 3.5z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
        </svg>
        <span>
          <span class="os24-contact-links__label">Call / SMS</span>
          <span class="os24-contact-links__detail">{{ phone | escape }}</span>
        </span>
      </a>
    </li>
  {%- endif -%}
  {%- if email != blank -%}
    <li>
      <a href="mailto:{{ email | escape }}" class="os24-contact-links__item">
        <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="22" height="22">
          <rect x="3" y="5" width="18" height="14" rx="2.5" fill="none" stroke="currentColor" stroke-width="1.8"/>
          <path d="M4 7l8 6 8-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
        </svg>
        <span>
          <span class="os24-contact-links__label">Email</span>
          <span class="os24-contact-links__detail">{{ email | escape }}</span>
        </span>
      </a>
    </li>
  {%- endif -%}
</ul>
{%- if settings.os24_hours != blank -%}
  <p class="os24-contact-links__hours">Hours: {{ settings.os24_hours | escape }}</p>
{%- endif -%}
