{%- comment -%}
  Renders the original 24 OnlineShop logo (assets/24onlineshop-logo.png,
  grid background removed). Used by the header when no logo image is
  uploaded in Theme settings > Logo. Width follows Theme settings > Logo width.

  Usage:
  {% render 'os24-logo' %}
{%- endcomment -%}
{%- liquid
  assign logo_width = settings.logo_width | default: 100
  assign logo_height = logo_width | times: 338 | divided_by: 396
-%}
<span class="os24-logo">
  <img
    src="{{ '24onlineshop-logo.png' | asset_url }}"
    alt="{{ shop.name | escape }}"
    width="{{ logo_width }}"
    height="{{ logo_height }}"
    class="os24-logo__img"
    style="--os24-logo-width: {{ logo_width }}px;"
    fetchpriority="high"
  >
</span>
